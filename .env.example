# Scholar Flow — API Configuration
# Copy this to .env and fill in your keys

# PubMed (NCBI E-utilities) — get key at https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
NCBI_API_KEY=

# Semantic Scholar — get key at https://www.semanticscholar.org/product/api
S2_API_KEY=

# IEEE Xplore — get key at https://developer.ieee.org/
IEEE_API_KEY=

# Scopus (Elsevier) — get key at https://dev.elsevier.com/
SCOPUS_API_KEY=

# CrossRef — just your email for polite pool access
CROSSREF_EMAIL=

# Zotero — get key at https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_USER_ID=
